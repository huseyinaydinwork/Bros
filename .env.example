# ---- Zorunlu ----
# Alan adı (DNS A kaydı sunucunun IP adresini göstermeli). www. yönlendirmesi otomatik.
BUROS_DOMAIN=buros.example.com
# Güçlü, rastgele bir parola: openssl rand -hex 24
POSTGRES_PASSWORD=
# /admin paneline girebilecek hesapların e-postaları (önce bu e-postalarla üye olun)
BUROS_PLATFORM_ADMINS=huseyinaydinwork@gmail.com

# ---- E-posta (birini doldurun; ikisi de boşsa e-postalar yalnızca panelde görünür) ----
MAIL_FROM=bürOS <bildirim@buros.example.com>
# SMTP (Yandex, Google Workspace, Amazon SES, Brevo, Mailgun ...)
SMTP_HOST=
SMTP_PORT=587
# 465 portu (doğrudan TLS) için 1 yapın; 587'de STARTTLS kendiliğinden kullanılır
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
# veya Resend
RESEND_API_KEY=

# ---- İsteğe bağlı: dosyaları S3 uyumlu depoda tutmak (AWS S3, Cloudflare R2, MinIO) ----
# Boş bırakılırsa dosyalar app-data biriminde (/data) saklanır.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# ---- İsteğe bağlı ----
# Oturum süresi (saat), varsayılan 168 (7 gün)
SESSION_HOURS=168
# Harici (yönetilen) PostgreSQL kullanacaksanız docker-compose.yml içindeki DATABASE_URL satırını
# bu değerle değiştirin ve db servisini kaldırın. SSL için ?sslmode=require ekleyin.
# DATABASE_URL=postgres://kullanici:parola@host:5432/buros?sslmode=require

# ---- Yasal metinler (/hukuki sayfasında kullanılır; boş kalanlar sayfada işaretli görünür) ----
BUROS_COMPANY=
BUROS_COMPANY_SHORT=bürOS
BUROS_COMPANY_ADDRESS=
BUROS_MERSIS=
BUROS_KEP=
BUROS_KVKK_EMAIL=kvkk@buros.example.com
BUROS_SUPPORT_EMAIL=destek@buros.example.com
# Barındırma ve e-posta sağlayıcısının adı ve ülkesi, ör. "Natro (Türkiye)" / "Yandex 360 (Rusya)"
BUROS_HOSTING=
BUROS_MAIL_SERVICE=
# Yetkili mahkeme, ör. "İstanbul (Çağlayan)"
BUROS_COURT=
# Deneme/abonelik bittikten sonra verilerin silinmeden önce tutulduğu gün sayısı
BUROS_RETENTION_DAYS=90
BUROS_LEGAL_DATE=1 Ekim 2026
